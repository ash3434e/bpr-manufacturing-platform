{
  "name": "bpr-manufacturing-platform",
  "version": "1.0.0",
  "description": "BPR Manufacturing Platform - Desktop Application",
  "main": "electron/main.js",
  "author": "BPR Manufacturing",
  "license": "MIT",
  "scripts": {
    "build-frontend": "cd frontend && npm run build",
    "start-electron": "electron .",
    "package-exe": "npm run build-frontend && electron-builder --win portable",
    "package-installer": "npm run build-frontend && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.bpr.demo.presentation",
    "productName": "BPR Demo Presentation",
    "asar": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "!backend/node_modules/.cache",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/.bin"
    ],
    "extraResources": [
      {
        "from": "backend/db",
        "to": "db",
        "filter": ["schema.sql", "seed.js", "init.js", "bpr.db"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "electron/icon.ico"
    },
    "portable": {
      "artifactName": "BPR-Manufacturing-Platform.${ext}"
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  }
}
